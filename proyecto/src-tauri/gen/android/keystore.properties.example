# Archivo de configuración para firmar la aplicación Android (Release)
# Copia este archivo como 'keystore.properties' en este mismo directorio y completa los datos.

# Ruta del archivo Keystore (relativo a esta carpeta gen/android o absoluto)
# Por ejemplo, si lo creas aquí mismo: release-key.jks
storeFile=release-key.jks

# Contraseña del archivo Keystore
storePassword=tu_contraseña_del_keystore

# Alias de la clave creada dentro del Keystore
keyAlias=tu_alias_de_clave

# Contraseña de la clave específica
keyPassword=tu_contraseña_de_clave
